  query GetDomainRegistrantContact($domainName: String!) {
    getDomainRegistrantContact(domainName: $domainName) {
      ... on DomainRegistrantContactInfo {
        firstName
        lastName
        companyName
        address1
        address2
        city
        state
        zip
        country
        phone
        email
        isVerified
      }
      ... on NotFoundError {
        message
      }
      ... on UnauthorizedError {
        message
      }
      ... on ServiceUnavailable {
        message
      }
    }
  }
`,tU=eg.gql`
  mutation UpdateDomainContacts($input: UpdateDomainContactsInput!) {
    updateDomainContacts(input: $input) {
      ... on UpdateDomainContactsResult {
        success
        domain {
          id
          registrantEmailVerified
        }
      }
      ... on NotFoundError {
        message
      }
      ... on UserError {
        message
      }
      ... on UnauthorizedError {
        message
      }
      ... on ServiceUnavailable {
        message
      }
