  fragment ReplAnalyticsDurationResult on ReplAnalyticsDuration {
    __typename
    results {
      __typename
      value
      count
    }
  }
`,ty=th.gql`
  query ReplAnalyticsDuration(
    $id: String!
    $input: ReplAnalyticsDurationInput!
  ) {
    getRepl(id: $id) {
      ... on Repl {
        __typename
        id
        analyticsDuration(input: $input) {
          ... on ReplAnalyticsDuration {
            ...ReplAnalyticsDurationResult
          }
          ... on NotFoundError {
            __typename
            message
          }
          ... on UserError {
            __typename
            message
          }
        }
      }
      ... on Error {
        message
      }
    }
